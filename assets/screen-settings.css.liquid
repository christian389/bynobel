@font-face { font-family: 'i'; src: url({{ 'icomoon.woff' | asset_url }}) format('woff'); font-display: swap; }

:root {
  --theme_text:     var(--white);
  --theme_bg:       {{ settings.palette_accent }};
  --theme_bg_dark:  {{ settings.palette_accent | color_darken: 10 }};
  --theme_bg_fade:  {{ settings.palette_accent | color_lighten: 10 }};
  --theme_bg_light: {{ settings.palette_light }};

  --theme_btn_text:    {{ settings.regular_button_text_color }};
  --theme_bg_btn:      {{ settings.regular_button_color }};
  --theme_bg_btn_dark: {{ settings.regular_button_color | color_darken: 10 }};
  --theme_bg_btn_fade: {{ settings.regular_button_color | color_lighten: 10 }};

  --tertiary_text:      {{ settings.buy_button_text_color }};
  --tertiary_bg:        {{ settings.buy_button_color }};
  --tertiary_bg_dark:   {{ settings.buy_button_color | color_darken: 10 }};
  --tertiary_bg_fade:   {{ settings.buy_button_color | color_lighten: 10 }};
  --tertiary_fg:        var(--tertiary_text);
  --tertiary_btn_text:  var(--tertiary_text);
  --tertiary_bg_btn:    var(--tertiary_bg);

  --quaternary_text:    {{ settings.dynamic_buy_button_text_color }};
  --quaternary_bg:      {{ settings.dynamic_buy_button_color }};
  --quaternary_bg_dark: {{ settings.dynamic_buy_button_color | color_darken: 10 }};
  --quaternary_bg_fade: {{ settings.dynamic_buy_button_color | color_lighten: 10 }};
  --quaternary_btn_text: var(--quaternary_text);
  --quaternary_bg_btn:   var(--quaternary_bg);

  --body_bg:            {{ settings.body_background_color }};

  --top_search_bg:var(--body_bg);
  --input_fg:    var(--dark);
  --input_bd: {{ settings.palette_black | color_to_rgb | color_modify: 'alpha', 0.08 }};
  --custom_input_bd: {{ settings.palette_black | color_to_rgb | color_modify: 'alpha', 0.08 }};

  --alert_error:        {{ settings.negative_vibes }};
  --alert_error_bg:     {{ settings.negative_vibes | color_lighten: 50 }};
  --alert_valid:        {{ settings.positive_vibes }};
  --lime:               {{ settings.positive_vibes }};
  --gallery:            {{ settings.palette_light }};
  --sand:               {{ settings.palette_light }};

  --product_label_bg:   {{ settings.product_label_color }};
  --product_label_bg_dark:{{ settings.product_label_color | color_darken: 5 }};
  --product_label_text: {{ settings.product_label_text_color }};
  --sale_label_bg:      {{ settings.sale_label_color }};
  --sale_label_bg_dark: {{ settings.sale_label_color | color_darken: 5 }};
  --sale_label_text:    {{ settings.sale_label_text_color }};

  --positive_bg:        {{ settings.positive_vibes }};
  --positive_bg_dark:   {{ settings.positive_vibes | color_darken: 5 }};
  --positive_fg:	      var(--white);

  --ar_op: 0.4;
  --ar_op_h: 1;
  --ar_bg: var(--{{ settings.arrows_color }}_bg);
  --ar_bg_h: var(--{{ settings.arrows_color }}_bg);
  --ar_fg: var(--{{ settings.arrows_color }}_fg);
  --ar_fg_h: var(--ar_fg);

  --price_color:        {{ settings.price_color }};
  --price_color_old:    {{ settings.compare_at_price_color }};

  --primary_text:       var(--{{ settings.text_color }});
  --primary_text_h:     var(--{{ settings.title_color }});

  --breadcrumbs_fz:  {{ settings.breadcrumbs_font_size }};

  --main_ff_h:          {{ settings.primary_font.family | remove: '"' }}, {{ settings.primary_font.fallback_families }};
  --main_fw_h:          {{ settings.primary_font.weight }};
  --main_fw_h_strong:   {{ settings.primary_font.weight | plus: 300 | at_most: 700 }};
  --main_fs_h:          {{ settings.primary_font.style }};
  --main_ls_h:          {% if settings.primary_letter_spacing == '0' %}normal{% else %}{{ settings.primary_letter_spacing | divided_by: 100.0 }}em{% endif %};
  --main_tt_h:          {{ settings.primary_case }};
  --main_lh_h:          {{ settings.heading_line_height | divided_by: 100.0 }};

{% if settings.body_font == 'primary' %}
  --main_ff:            var(--main_ff_h);
  --main_fs:            var(--main_fs_h);
  --main_tt:            var(--main_tt_h);
{% else %}
  --main_ff:            {{ settings.secondary_font.family | remove: '"' }}, {{ settings.secondary_font.fallback_families }};
  --main_fs:            {{ settings.secondary_font.style }};
  --main_tt:            {{ settings.secondary_case }};
{% endif %}
  --main_fw:            {{ settings.body_font_weight }};
  --main_fw_strong:     {{ settings.body_font_weight | plus: 300 | at_most: 700 }};

  --main_ls:            {% if settings.body_letter_spacing == '0' %}normal{% else %}{{ settings.body_letter_spacing | divided_by: 100.0 }}em{% endif %};
  --main_lh:            {{ settings.body_line_height | divided_by: 100.0 }};
  --main_fz:            {{ settings.body_font_size }};

  --main_h1:            {{ settings.h1_size }}px;
  --main_h2:            {{ settings.h2_size }}px;
  --main_h3:            {{ settings.h3_size }}px;
  --main_h4:            {{ settings.h4_size }}px;
  --main_h5:            {{ settings.h5_size }}px;
  --main_h_small:       var(--main_h5);

  --mob_h1:             {{ settings.h1_size_mobile }}px;
  --mob_h2:             {{ settings.h2_size_mobile }}px;
  --mob_h3:             {{ settings.h3_size_mobile }}px;
  --mob_h4:             {{ settings.h4_size_mobile }}px;
  --mob_h5:             {{ settings.h5_size_mobile }}px;
  --mob_h_small:        {{ settings.h5_size_mobile }}px;
  --mob_fz:             {{ settings.body_font_size_mobile }};
  --theme_btn_fz_mob:   {{ settings.button_fontsize_mobile }};

{% if settings.button_font == 'primary' %}
  --theme_btn_ff:            var(--main_ff_h);
  --theme_btn_fs:            var(--main_fs_h);
{% else %}
  --theme_btn_ff:            {{ settings.secondary_font.family | remove: '"' }}, {{ settings.secondary_font.fallback_families }};
  --theme_btn_fs:            {{ settings.secondary_font.style }};
{% endif %}
  --theme_btn_fw:            {{ settings.button_font_weight }};
  --theme_btn_fz:          {{ settings.button_fontsize }};
  --theme_btn_tt:          {{ settings.button_case }};
  --theme_btn_ls:          {% if settings.button_letter_spacing == '0' %}normal{% else %}{{ settings.button_letter_spacing | divided_by: 100.0 }}em{% endif %};
  --button_bw: {{ settings.button_border }}px;
  --button_corners: {{ settings.button_radius }}px;
  --button_height: {{ settings.button_height }}px;

{% if settings.prices_font == 'primary' %}
  --price_ff:            var(--main_ff_h);
  --price_fs:            var(--main_fs_h);
{% else %}
  --price_ff:            {{ settings.secondary_font.family | remove: '"' }}, {{ settings.secondary_font.fallback_families }};
  --price_fs:            {{ settings.secondary_font.style }};
{% endif %}
  --price_fw:            {{ settings.prices_font_weight }};
  --l4cl_h_small: {{ settings.productcard_vendor_size }};

{% unless settings.everything_rounded %}
  --b2r: 0;
{% endunless %}
  --b2p: {{ settings.images_corner_radius }}px;

  --glw: {% if settings.width == 2000 %}10000{% else %}{{ settings.width }}{% endif %}px;
  --ratio: {{ settings.custom_product_image_ratio | divided_by: 100.0 }};
  --theme_bg_gradient: var(--light_gradient);
  --circle_size: 55px;
}
@media only screen and (max-width: 760px) {
  :root {
    --main_mr: 20px;
    --size_70_f: 12vw;
    --main_fz: var(--mob_fz);
    --theme_btn_fz: var(--theme_btn_fz_mob);
    --main_h1: var(--mob_h1);
    --main_h2: var(--mob_h2);
    --main_h3: var(--mob_h3);
    --main_h4: var(--mob_h4);
    --main_h5: var(--mob_h5);
    --main_h6: var(--mob_h6);
    --main_lead: var(--mob_lead);
  {% if settings.button_wide_mobile %}
    /*--btn_ph: calc(18px);*/
  {% endif %}
    --header_height_static: 70px; /* the header height is always 70px on mobile */
  }
}
:root {
  --white:              {{ settings.palette_white }};
  --white_bg:           var(--white);
  --white_bg_dark:      {{ settings.palette_white | color_darken: 5 }};
  --white_bg_var:       var(--white_bg);
  --white_bd:           {{ settings.palette_black | color_to_rgb | color_modify: 'alpha', 0.07 }};
  --white_fg:           var(--black);
  --white_pl:           {{ settings.palette_black | color_lighten: 10 }};
  --white_btn_bg:       var(--accent_bg);
  --white_btn_bg_dark:  {{ settings.palette_accent | color_darken: 7 }};
  --white_btn_fg:       var(--accent_fg);

  --black:              {{ settings.palette_black }};
  --black_bg:           var(--black);
  --black_bg_dark:      {{ settings.palette_black | color_darken: 5 }};
