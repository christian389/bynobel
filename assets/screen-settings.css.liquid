  --black_pl:           {{ settings.palette_white | color_lighten: 10 }};
  --black_btn_bg:       var(--accent_bg);
  --black_btn_bg_dark:  {{ settings.palette_accent | color_darken: 7 }};
  --black_btn_fg:       var(--accent_fg);

  --light:              {{ settings.palette_light }};
  --light_bg:           var(--light);
  --light_bg_dark:      {{ settings.palette_light | color_darken: 5 }};
  --light_bg_var:       {{ settings.palette_light | color_darken: 5 }};
  --light_bd:           {{ settings.palette_black | color_to_rgb | color_modify: 'alpha', 0.07 }};
  --light_fg:           var(--black);
  --light_pl:           {{ settings.palette_black | color_lighten: 10 }};
  --light_btn_bg:       var(--accent_bg);
  --light_btn_bg_dark:  {{ settings.palette_accent | color_darken: 7 }};
  --light_btn_fg:       var(--accent_fg);

  --light_2:            {{ settings.palette_light_2 }};
  --light_2_bg:         var(--light_2);
  --light_2_bg_dark:    {{ settings.palette_light_2 | color_darken: 5 }};
  --light_2_bg_var:     {{ settings.palette_light_2 | color_darken: 5 }};
  --light_2_bd:         {{ settings.palette_black | color_to_rgb | color_modify: 'alpha', 0.07 }};
  --light_2_fg:         var(--black);
  --light_2_pl:         {{ settings.palette_black | color_lighten: 10 }};
  --light_2_btn_bg:     var(--dark);
  --light_2_btn_bg_dark:{{ settings.palette_dark | color_darken: 7 }};
  --light_2_btn_fg:     var(--accent_fg);

  --accent:	            {{ settings.palette_accent }};
  --accent_bg:	        var(--accent);
  --accent_bg_dark:     {{ settings.palette_accent | color_darken: 5 }};
  --accent_bg_var:      {{ settings.palette_accent | color_darken: 5 }};
  --accent_bd:          {{ settings.palette_white | color_to_rgb | color_modify: 'alpha', 0.4 }};
  --accent_fg:	        var(--white);
  --accent_pl:          {{ settings.palette_white | color_lighten: 10 }};
  --accent_btn_bg:	    var(--accent_fg);
  --accent_btn_bg_dark:	{{ settings.palette_white | color_darken: 7 }};
  --accent_btn_fg:	    var(--accent_bg);

  --dark:	              {{ settings.palette_dark }};
  --dark_bg:	          var(--dark);
  --dark_bg_dark:       {{ settings.palette_dark | color_darken: 5 }};
  --dark_bg_var:        {{ settings.palette_dark | color_lighten: 5 }};
  --dark_bd:            {{ settings.palette_white | color_to_rgb | color_modify: 'alpha', 0.4 }};
  --dark_fg:	          var(--white);
  --dark_pl:            {{ settings.palette_white | color_lighten: 10 }};
  --dark_btn_bg:	      var(--accent_fg);
  --dark_btn_bg_dark:	  {{ settings.palette_accent | color_darken: 7 }};
  --dark_btn_fg:	      var(--accent_bg);

  --light_gradient:     {{ settings.palette_light_gradient }};
  --light_gradient_bg:  var(--light_gradient);

  --dark_gradient:     {{ settings.palette_dark_gradient }};
  --dark_gradient_bg:  var(--dark_gradient);
}

