{%- liquid
    case section.settings.items_width
      when 1
        assign width_class = 'width-100'
      when 2
        assign width_class = 'width-50'
      when 3
        assign width_class = 'width-33'
      when 4
        assign width_class = 'width-25'
      when 5
        assign width_class = 'width-20'
    endcase
  
    assign last_blocks = section.blocks.size | modulo : section.settings.items_width

    assign ref_img = section.blocks.first.settings.image
    if section.blocks.first.settings.video
      assign ref_img = section.blocks.first.settings.video
    endif
    if section.settings.enable_custom_height
      assign padding_bottom = 0
    else
      if section.settings.height == 'adapt'
        assign padding_bottom = 1 | divided_by: ref_img.aspect_ratio | times: 100 | round: 2
      else
        assign aspect_ratio = section.settings.height | split: '/'
        assign temp = aspect_ratio[0] | append: '.0'
        assign ratio = aspect_ratio[1] | divided_by: temp | round: 2
        assign padding_bottom = ratio | times: 100 | round: 2
      endif
    endif

    if section.settings.mobile_height == 'adapt'
      if section.blocks.first.settings.image_mobile
        assign ref_img = section.blocks.first.settings.image_mobile
      endif
      assign padding_bottom_mobile = 1 | divided_by: ref_img.aspect_ratio | times: 100 | round: 2
    else
      assign aspect_ratio = section.settings.mobile_height | split: '/'
      assign temp = aspect_ratio[0] | append: '.0'
      assign ratio = aspect_ratio[1] | divided_by: temp | round: 2
      assign padding_bottom_mobile = ratio | times: 100 | round: 2
    endif
  -%}
  
  <article>
    <ul class="l4ft
      {% if section.settings.width == 'wide' %}fullwidth{% endif %}
      {% unless section.settings.image_zoom %}no-hover{% endunless %}
      {% if section.settings.layout_mobile == 'rows' %}mobile-scroll{% endif %}
      "
      style="--spacing: {{ section.settings.space_between }}px;">
      {% assign counter = 1 %}
      {%- for block in section.blocks -%}
        {%- liquid
          capture current
            cycle 1, 2
          endcapture
            assign blocks_left = forloop.length | minus: forloop.index
            assign items_per_row = section.settings.items_width
            if blocks_left < last_blocks
              assign width = 100 | divided_by: last_blocks
              assign different_width_class = 'width-' | append: width
              assign items_per_row = last_blocks
            else
              assign different_width_class = false
            endif
          if different_width_class
            assign img_width = width
          else
            assign img_width = width_class | remove: 'width-' | plus: 0
          endif

          assign border_class = ''
          if counter == 1
            assign border_class = 'first-in-row'
          elsif counter == items_per_row
            assign border_class = 'last-in-row'
          endif
        -%}

        <li class="block-{{ block.id }}
          {% if section.settings.show_content_below %}{{ block.settings.text_position | split: ' ' | last }}{% else %}{{ block.settings.text_position }}{% endif %}
          {{ width_class }}
          {% comment %}{{ section.settings.height }}{% endcomment %}
          {% comment %}{{ section.settings.mobile_height }}-mobile{% endcomment %}
          {% if different_width_class %}{{ different_width_class }}{% endif %}
          text-{{ block.settings.text_position | split: ' ' | last }}
          {{ border_class }}
          "
          {{ block.shopify_attributes }}
          {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500" data-sal-delay="{{ forloop.index0 | times: 100 }}"{% endif %}
          style="
          {% if section.settings.enable_custom_height %}--mih_desktop: {{ section.settings.custom_height }}px;{% endif %}
          {% if block.settings.enable_custom_font_styling %}font-size:{{ block.settings.font_size }};{% endif %}
            --align_text: {{ block.settings.text_position | split: ' ' | first }};
            --justify_text: {{ block.settings.text_position | split: ' ' | last }};
            --height: {% if section.settings.enable_custom_height %}{{ section.settings.custom_height }}px{% else %}0{% endif %};
            --padding_bottom: {{ padding_bottom }};
            --padding_bottom_mobile: {{ padding_bottom_mobile }};
          "

        >
          {%- if counter == items_per_row -%}
            {% assign counter = 1 %}
          {%- else -%}
            {% assign counter = counter | plus: 1 %}
          {%- endif -%}
          {%- liquid
            assign empty = true
            if section.settings.title != blank
              assign empty = false
            elsif block.settings.text
              assign empty = false
            elsif block.settings.link_text != empty and block.settings.link_url != blank
              assign empty = false
            endif

          -%}
          <div class="palette-{{ block.settings.color_palette }}
              module-color-palette
              main{% if empty %} empty{% endif %}">
            <figure>
              {%- if block.settings.video -%}
                {% if block.settings.enable_controls %}<a href="./" class="link-overlay{% if block.settings.image_mobile %} mobile-hide{% endif %}" aria-label="{{ block.settings.title | escape | default: "Play video" }}"></a>{% endif %}
                <picture {% if block.settings.image_mobile %}class="mobile-hide"{% endif %}>
                  <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                  {%- liquid
                    assign source = block.settings.video.sources | where: "height", 1080 | where: "format", "mp4" | first
                    if source == nil
                      assign source = block.settings.video.sources | where: "format", "mp4" | first
                    endif
                    if source == nil
                      assign source = block.settings.video.sources | where: "format", "mov" | first
                    endif
                    if source == nil
                      assign source = block.settings.video.sources.first
                    endif
                  -%}
                  <video class="lazy next-video" {% if block.settings.enable_controls %}{% if block.settings.video_mute %} muted{% endif %}{% else %}autoplay muted{% endif %} loop playsinline poster="{{ block.settings.video.preview_image | image_url }}">
                    <source data-src="{{ source.url }}" type="video/mp4">
                  </video>
                </picture>
                {% if block.settings.enable_controls %}
                  <i aria-hidden="true" class="icon-play {% if block.settings.image_mobile %}mobile-hide{% endif %}"></i>
                {% endif %}
                {% if block.settings.image_mobile %}
                  <picture class="mobile-only">
                    <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                    <img
                      src="{{ block.settings.image_mobile | image_url: width: 620 }}"
                      srcset="{% render 'image-srcset', image: block.settings.image_mobile %}"
                      sizes="(min-width: 768px) 0, {% if section.settings.layout_mobile == 'compact' %}315px{% else %}100vw{% endif %}"
                      width="620"
                      height="700"
                      alt="{{ block.settings.image_mobile.alt | default: block.settings.title | escape }}"
                      style="object-position: {{ block.settings.image.presentation.focal_point }}"
                      class="mobile-only"
                      {% unless section.index == 1 and forloop.index == 1 %}loading="lazy"{% endunless %}
                    >
                  </picture>
                {% endif %}
              {%- elsif block.settings.image -%}
              {% if block.settings.image_mobile %}
                <picture class="mobile-only">
                    <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                    <img
                      src="{{ block.settings.image_mobile | image_url: width: 620 }}"
                      srcset="{% render 'image-srcset', image: block.settings.image_mobile %}"
                      sizes="(min-width: 768px) 0, {% if section.settings.layout_mobile == 'compact' %}315px{% else %}100vw{% endif %}"
                      width="620"
                      height="700"
                      alt="{{ block.settings.image_mobile.alt | default: block.settings.title | escape }}"
                      style="object-position: {{ block.settings.image.presentation.focal_point }}"
                      {% unless section.index == 1 and forloop.index == 1 %}loading="lazy"{% endunless %}
                    >
                </picture>
                {% endif %}
                <picture {% if block.settings.image_mobile %}class="mobile-hide"{% endif %}>
                  <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                    <img
                      src="{{ block.settings.image | image_url: width: 620 }}"
                      srcset="{% render 'image-srcset', image: block.settings.image %}"
                      sizes="
                       {% if section.settings.width == 'boxed' or settings.width < 2000 %}
                        (min-width: {{ settings.width }}px) {% if img_width == 100 %}{{ settings.width }}px{% else %}calc({{ settings.width }}px * 0.{{ img_width }}){%- endif -%},
                       {% endif %}
                        (min-width: 760px) {% if img_width == 100 %}100vw{% else %}calc(100vw * 0.{{ img_width }}){%- endif -%},
                        {% if block.settings.image_mobile %}0{% else %}{% if section.settings.layout_mobile == 'compact' %}315px{% else %}100vw{% endif %}{% endif %}
                      "
                      width="620"
                      height="700"
                      alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                      style="object-position: {{ block.settings.image.presentation.focal_point }}"
                      {% unless section.index == 1 and forloop.index == 1 %}loading="lazy"{% endunless %}
                    >
                </picture>
              {% else %}
                <picture>
                  <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                  {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                </picture>
              {% endif %}
            </figure>
            {%- if section.settings.show_content_below == false -%}
            <div>
              {%- if block.settings.title != blank -%}
                <{{ block.settings.title_size }} class="ff-{{ block.settings.title_font }} {% if block.settings.enable_custom_text_styling %}text-palette-{{ block.settings.title_color_palette }} fw-{{ block.settings.title_weight }}{% endif %}">{{ block.settings.title }}</{{ block.settings.title_size }}>
              {%- endif -%}
              {%- if block.settings.text -%}{{ block.settings.text }}{%- endif -%}
              {%- if block.settings.link_text != empty and block.settings.link_url != blank -%}
                <p class="link-btn button-palette-{{ block.settings.button_color_palette }}">
                  <a href="{{ block.settings.link_url }}" class="{% if block.settings.show_link %}inline{% elsif settings.button_style == 'inv' %} inv{% endif %}">
                    {{ block.settings.link_text }}&nbsp;{% if block.settings.show_link %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}
                  </a>
                </p>
              {%- endif %}
            </div>
            {%- endif -%}
            {%- unless block.settings.video -%}
              {%- if settings.banners_clickable and block.settings.link_url != blank -%}
                <a class="link-overlay" href="{{ block.settings.link_url }}" aria-label="{{ block.settings.title | escape | default: block.settings.image.alt | default: "Image banner" }}"></a>
              {%- endif -%}
            {%- endunless -%}
          </div>
          {%- if section.settings.show_content_below -%}
          <div class="content">
            {%- if block.settings.title != empty -%}
              <{{ block.settings.title_size }} class="ff-{{ block.settings.title_font }} {% if block.settings.enable_custom_text_styling %}text-palette-{{ block.settings.title_color_palette }} fw-{{ block.settings.title_weight }}{% endif %}">{{ block.settings.title }}</{{ block.settings.title_size }}>
            {%- endif -%}
            {%- if block.settings.text -%}{{ block.settings.text }}{%- endif -%}
            {%- if block.settings.link_text != empty and block.settings.link_url != blank -%}
              <p class="link-btn button-palette-{{ block.settings.button_color_palette }}">
                <a href="{{ block.settings.link_url }}" class="{% if block.settings.show_link %}inline{% elsif settings.button_style == 'inv' %} inv{% endif %}">
                  {{ block.settings.link_text }}&nbsp;{% if block.settings.show_link %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}
                </a>
              </p>
            {%- endif %}
          </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </article>
  
  <style>
    #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
    @media only screen and (min-width: 47.5em) {
      #shopify-section-{{ section.id }} .l4ft { margin-bottom: {{ section.settings.spacing_desktop | minus: section.settings.space_between }}px; }
    }
    @media only screen and (max-width: 47.5em) {
      #shopify-section-{{ section.id }} .l4ft { margin-bottom: 0; }
      {% if section.settings.layout_mobile == 'rows' %}
        #shopify-section-{{ section.id }} .l4ft { margin-bottom: {{ section.settings.spacing_mobile }}px; }
      {% else %}
        #shopify-section-{{ section.id }} .l4ft { margin-bottom: {{ section.settings.spacing_mobile | minus: 16 }}px; }
      {% endif %}
    }
    #shopify-section-{{ section.id }} li[style*="--padding_bottom"] > .main {
      flex-direction: row;
      flex-wrap: nowrap;
      min-height: 0!important;
      align-items: var(--align_text);
      justify-content: var(--justify_text);
    }
    {% if section.settings.enable_custom_height %}
    @media only screen and (min-width: 47.5em) {
      #shopify-section-{{ section.id }} li[style*="--padding_bottom"] > .main {
        min-height: var(--mih_desktop)!important;
      }
    }
    {% endif %}

    #shopify-section-{{ section.id }} li[style*="--padding_bottom"] > .main:after {
      content: "" !important;
      display: block !important;
      --banner_padding_v: calc(var(--cols_spacing) + calc(var(--cols_spacing) - var(--main_mr)));
      --banner_padding_h: calc(var(--cols_spacing) * 2);
      --banner_height: calc(var(--padding_bottom) *  1%);
      padding-bottom: calc(var(--banner_height) + var(--banner_padding_h) - var(--banner_padding_v));
    }
    @media only screen and (max-width: 47.5em) {
      .l4ft li[style*="--padding_bottom_mobile"] > .main {
        --padding_bottom: var(--padding_bottom_mobile);
      }
      #shopify-section-{{ section.id }} .main figure {
        position: absolute;
      }
      #shopify-section-{{ section.id }} .l4ft.mobile-scroll .main > figure:last-child {
        margin: 0;
      }
      #shopify-section-{{ section.id }} .main.empty, .l4ft .main.empty img, .l4ft .main.empty video, .l4ft .main.empty iframe, .l4ft .main.empty svg {
        --mih_mobile: 100%;
      }
      #shopify-section-{{ section.id }} .l4ft.fullwidth .content {
        padding-inline: var(--rpp);
      }
    }
  </style>
  
  {% schema %}
{
  "name": "t:sections.banner_columns.name",
  "max_blocks": 9,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "range",
      "id": "items_width",
      "label": "t:sections.banner_columns.settings.items_width.label",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.banner_columns.settings.width.label",
      "options": [
        {
          "value": "boxed",
          "label": "t:sections.banner_columns.settings.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.banner_columns.settings.width.options__2.label"
        }
      ],
      "default": "boxed"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.banner_columns.settings.height.label",
      "options": [
        {
          "value": "16/9",
          "label": "t:global.layout.height.16_9.label"
        },
        {
          "value": "1/1",
          "label": "t:global.layout.height.1_1.label"
        },
        {
          "value": "4/5",
          "label": "t:global.layout.height.4_5.label"
        },
        {
          "value": "adapt",
          "label": "t:global.layout.height.adapt_first.label"
        }
      ],
      "default": "16/9"
    },
    {
      "id": "enable_custom_height",
      "type": "checkbox",
      "label": "t:sections.banner_columns.settings.enable_custom_height.label"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "t:sections.banner_columns.settings.custom_height.label",
      "info": "t:sections.banner_columns.settings.custom_height.info",
      "min": 250,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "space_between",
      "label": "t:sections.banner_columns.settings.space_between.label",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "id": "image_zoom",
      "type": "checkbox",
      "label": "t:sections.banner_columns.settings.image_zoom.label",
      "default": false
    },
    {
      "id": "show_content_below",
      "type": "checkbox",
      "label": "t:sections.banner_columns.settings.show_content_below.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.banner_columns.settings.mobile.header"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "t:sections.banner_columns.settings.mobile.layout_mobile.label",
      "options": [
        {
          "value": "rows",
          "label": "t:sections.banner_columns.settings.mobile.layout_mobile.options__1.label"
        },
        {
          "value": "compact",
          "label": "t:sections.banner_columns.settings.mobile.layout_mobile.options__2.label"
        }
      ],
      "default": "rows"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "t:sections.banner_columns.settings.mobile.mobile_height.label",
      "options": [
        {
          "value": "16/9",
          "label": "t:global.layout.height.16_9.label"
        },
        {
          "value": "1/1",
          "label": "t:global.layout.height.1_1.label"
        },
        {
          "value": "4/5",
          "label": "t:global.layout.height.4_5.label"
        },
        {
          "value": "adapt",
          "label": "t:global.layout.height.adapt_first.label"
        }
      ],
      "default": "16/9"
    },
    {
      "type": "header",
      "content": "t:global.spacing.header"
    },
    {
      "id": "spacing_desktop",
      "type": "range",
      "label": "t:global.spacing.spacing_desktop.label",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "id": "spacing_mobile",
      "type": "range",
      "label": "t:global.spacing.spacing_mobile.label",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 30
    },
    {
      "id": "fix_zindex",
      "type": "range",
      "label": "t:global.fix_zindex.label",
      "info": "t:global.fix_zindex.info",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.banner_columns.blocks.image.name",
      "settings": [
        {
          "id": "image",
          "type": "image_picker",
          "label": "t:sections.banner_columns.blocks.image.settings.image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.banner_columns.blocks.image.settings.video.label"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:sections.banner_columns.blocks.image.settings.overlay_opacity.label",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        {
          "id": "enable_controls",
          "type": "checkbox",
          "label": "t:global.video.enable_controls.label",
          "info": "t:global.video.enable_controls.info"
        },
        {
          "type": "checkbox",
          "id": "video_mute",
          "label": "t:global.video.video_mute.label",
          "info": "t:global.video.video_mute.info",
          "default": true
        },
        {
          "type": "select",
          "id": "color_palette",
          "label": "t:global.color_palette.label",
          "options": [
            {
              "value": "white",
              "label": "t:global.color_palette.white.label"
            },
            {
              "value": "black",
              "label": "t:global.color_palette.black.label"
            },
            {
              "value": "light",
              "label": "t:global.color_palette.light.label"
            },
            {
              "value": "dark",
              "label": "t:global.color_palette.dark.label"
            },
            {
              "value": "accent",
              "label": "t:global.color_palette.accent.label"
            },
            {
              "value": "light_2",
              "label": "t:global.color_palette.light_2.label"
            },
            {
              "value": "light_gradient",
              "label": "t:global.color_palette.light_gradient.label"
            },
            {
              "value": "dark_gradient",
              "label": "t:global.color_palette.dark_gradient.label"
            }
          ],
          "default": "white"
        },
        {
          "id": "text_position",
          "type": "select",
          "label": "t:global.typography.text_position.label",
          "options": [
            {
              "value": "start",
              "label": "t:global.typography.text_position.top_left.label"
            },
            {
              "value": "start center",
              "label": "t:global.typography.text_position.top_center.label"
            },
            {
              "value": "start end",
              "label": "t:global.typography.text_position.top_right.label"
            },
            {
              "value": "center start",
              "label": "t:global.typography.text_position.center_left.label"
            },
            {
              "value": "center",
              "label": "t:global.typography.text_position.center_center.label"
            },
            {
              "value": "center end",
              "label": "t:global.typography.text_position.center_right.label"
            },
            {
              "value": "end start",
              "label": "t:global.typography.text_position.bottom_left.label"
            },
            {
              "value": "end center",
              "label": "t:global.typography.text_position.bottom_center.label"
            },
            {
              "value": "end",
              "label": "t:global.typography.text_position.bottom_right.label"
            }
          ],
          "default": "center"
        },
        {
          "type": "header",
          "content": "t:global.typography.heading.header"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.typography.title.label",
          "default": "Image banner"
        },
        {
          "type": "select",
          "id": "title_font",
          "label": "t:global.typography.title_font.label",
          "options": [
            {
              "value": "primary",
              "label": "t:global.typography.font.primary.label"
            },
            {
              "value": "secondary",
              "label": "t:global.typography.font.secondary.label"
            }
          ],
          "default": "primary"
        },
        {
          "type": "select",
          "id": "title_size",
          "label": "t:global.typography.title_size.label",
          "options": [
            {
              "value": "h4",
              "label": "t:global.typography.title_size.h4.label"
            },
            {
              "value": "h3",
              "label": "t:global.typography.title_size.h3.label"
            },
            {
              "value": "h2",
              "label": "t:global.typography.title_size.h2.label"
            },
            {
              "value": "h1",
              "label": "t:global.typography.title_size.h1.label"
            }
          ],
          "default": "h2"
        },
        {
          "type": "checkbox",
          "id": "enable_custom_text_styling",
          "label": "t:global.typography.enable_custom_text_styling.label",
          "info": "t:global.typography.enable_custom_text_styling.info"
        },
