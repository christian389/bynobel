{% liquid
  assign custom_background = section.settings.background_color
  if section.settings.background_gradient != empty
    assign custom_background = section.settings.background_gradient
  endif
  
  capture background_classes
  if section.settings.background_overlay_opacity == 0
    echo 'no-padding'
  else
    if section.settings.background_height == 0 or section.settings.background_width == 0
      echo 'no-padding-desktop'
    endif
    if section.settings.background_height_mobile == 0 or section.settings.background_width_mobile == 0
      echo ' no-padding-mobile'
    endif
  endif
endcapture

-%}
<article class="m6bx {{ background_classes }} {{ section.settings.width }} text-{{ section.settings.text_alignment }} align-center size-{{ section.settings.height }} height-mobile-{{ section.settings.height_mobile }}" style="{% if section.settings.enable_custom_height %}--mih_desktop:{{ section.settings.custom_height }}px;{% endif %}">
  <div class="palette-{{ section.settings.background_color_palette }} module-color-palette img-overlay overlay-theme{% if section.settings.background_position == 'right' %} text-end{% endif %}{% if section.settings.custom_background %} dark-overlay-theme{% endif %}"
    style="--mih_desktop: {{ section.settings.background_height }}%; --dist_half: {{ 100 | minus: section.settings.background_width }}%; --mih_mobile: {{ section.settings.background_height_mobile }}%; --dist_half_mobile: {{ 100 | minus: section.settings.background_width_mobile }}%; opacity:{{ section.settings.background_overlay_opacity | divided_by: 100.0 }}"></div>
    <div {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500" data-sal-delay="300"{% endif %} class="align-{{ section.settings.text_alignment }}" style="--main_lh_h: {{ section.settings.line_height | divided_by: 100.0 }}">
      {%- if section.settings.title != empty -%}
        <{{ section.settings.title_size }} class="ff-{{ section.settings.title_font }} {% if section.settings.enable_custom_text_styling %}text-palette-{{ section.settings.title_color_palette }} fw-{{ section.settings.title_weight }}{% endif %} primary-title{% if section.settings.image %} overlay-img{% endif %}"
          style="
          {% if section.settings.image %}
            background-image: url({{ section.settings.image | image_url: width: section.settings.content_width }});
            background-position: {{ section.settings.image.presentation.focal_point }};
          {% endif %}
          max-width: {% if section.settings.content_width == 2000 %}100%{% else %}{{ section.settings.content_width }}px{% endif %};
          ">
          {{ section.settings.title }}
        </{{ section.settings.title_size }}>
      {%- endif -%}
    </div>
</article>

<style>
  {% if section.settings.custom_background %}
    #shopify-section-{{ section.id }} .img-overlay.overlay-theme { --primary_bg: {{ custom_background }}; }
  {% endif %}
  #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
  {% if section.settings.enable_custom_title_size %}
    #shopify-section-{{ section.id }} > article { container-type: inline-size; }
    #shopify-section-{{ section.id }} .primary-title { 
      --main_{{ section.settings.title_size }}: {{ section.settings.custom_title_size | divided_by: 6 }}cqw; 
    }
  {% endif %}
  #shopify-section-{{ section.id }} .no-padding .primary-title { margin-bottom: 0; }
  @media only screen and (min-width: 47.5em) {
    #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_desktop }}px; }
    #shopify-section-{{ section.id }} .no-padding-desktop .primary-title { margin-bottom: 0; }
  }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_mobile }}px; }
    #shopify-section-{{ section.id }} .no-padding-mobile .primary-title { margin-bottom: 0; }
  }
</style>
 
