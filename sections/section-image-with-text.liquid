{% liquid
  assign custom_background = section.settings.background_color
  if section.settings.background_gradient != empty
    assign custom_background = section.settings.background_gradient
  endif
  
  assign align = section.settings.text_position | split: ' ' | first
  assign text_position = section.settings.text_position | split: ' ' | last

  capture background_classes
    if section.settings.background_overlay_opacity == 0
      echo 'no-padding'
    else
      if section.settings.background_height == 0 or section.settings.background_width == 0 or section.settings.background_overlay_opacity == 0
        echo 'no-padding-desktop'
      endif
      if section.settings.background_height_mobile == 0 or section.settings.background_width_mobile == 0 or section.settings.background_overlay_opacity == 0
        echo ' no-padding-mobile'
      endif
    endif
  endcapture
-%}

<article class="m6bx wide {{ background_classes }}">
  <div class="palette-{{ section.settings.background_color_palette }} module-color-palette img-overlay overlay-theme{% if section.settings.background_position == 'right' %} text-end{% endif %}{% if section.settings.custom_background %} dark-overlay-theme{% endif %}"
    style="--mih_desktop: {{ section.settings.background_height }}%; --dist_half: {{ 100 | minus: section.settings.background_width }}%; --mih_mobile: {{ section.settings.background_height_mobile }}%; --dist_half_mobile: {{ 100 | minus: section.settings.background_width_mobile }}%; opacity:{{ section.settings.background_overlay_opacity | divided_by: 100.0 }}"></div>
  <div>
    <div class="palette-{{ section.settings.color_palette }} module-color-palette m6fr {{ section.settings.width }} {{ section.settings.height }} size-xs-mobile" {% if section.settings.enable_custom_height %}style="--mh:{{ section.settings.custom_height }}px"{% endif %}>
      <article class="width-50{% if section.settings.layout == 'image-right' %} inv{% endif %} {{ align }} mobile-static {% if section.settings.overlay_opacity == 0 %} plain{% endif %}">
        <figure {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500"{% endif %}>
          {% if section.settings.video %}
            {% if section.settings.enable_controls %}<a href="./" aria-label="{{ section.settings.title | escape | default: "Play video" }}">{% endif %}
              <picture>
                <span class="img-overlay" style="--overlay_opacity:{{ section.settings.overlay_opacity_img | divided_by: 100.0 }}"></span>
                {%- liquid
                  assign source = section.settings.video.sources | where: "height", 1080 | where: "format", "mp4" | first
                  if source == nil
                    assign source = section.settings.video.sources | where: "format", "mp4" | first
                  endif
                  if source == nil
                    assign source = section.settings.video.sources | where: "format", "mov" | first
                  endif
                  if source == nil
                    assign source = section.settings.video.sources.first
                  endif
                -%}
                <video class="lazy next-video" {% if section.settings.enable_controls %}{% if section.settings.video_mute %} muted{% endif %}{% else %}autoplay muted{% endif %} loop playsinline poster="{{ section.settings.video.preview_image | image_url }}" {% unless section.settings.fill_image %}style="object-fit:contain"{% endunless %}>
                  <source data-src="{{ source.url }}" type="video/mp4">
                </video>
              </picture>
              {% if section.settings.enable_controls %}
                <i aria-hidden="true" class="icon-play"></i>
              {% endif %}
              {% if section.settings.enable_controls %}</a>{% endif %}
          {%- elsif section.settings.image -%}
            <picture class="{% if section.settings.image_mobile %} mobile-hide{% endif %}">
              <span class="img-overlay" style="--overlay_opacity:{{ section.settings.overlay_opacity_img | divided_by: 100.0 }}"></span>
              <img
                src="{{ section.settings.image | image_url: width: 100, height: 100, width: 640 }}"
                srcset="{% render 'image-srcset', image: section.settings.image %}"
                sizes="(min-width: 1300px) calc({% if settings.width < 2000 %}{{ settings.width }}px{% else %}100vw{% endif %} / 2), 100vw"
                width="640"
                height="530"
                alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
                {% unless section.settings.fill_image %}style="object-fit:contain"{% endunless %}
                {% unless section.index == 1 %}loading="lazy"{% endunless %}
              >
            </picture>
            {%- if section.settings.image_mobile -%}
              <span class="img-overlay" style="--overlay_opacity:{{ section.settings.overlay_opacity_img | divided_by: 100.0 }}"></span>
              <picture class="mobile-only">
                <img
                  src="{{ section.settings.image_mobile | image_url: width: 100, height: 100, width: 640 }}"
                  srcset="{% render 'image-srcset', image: section.settings.image_mobile %}"
                  sizes="(min-width: 1300px) calc({% if settings.width < 2000 %}{{ settings.width }}px{% else %}100vw{% endif %} / 2), 100vw"
                  width="640"
                  height="530"
                  alt="{{ section.settings.image_mobile.alt | default: section.settings.title | escape }}"
                  {% unless section.settings.fill_image %}style="object-fit:contain"{% endunless %}
                  loading="lazy"
                >
              </picture>
            {% endif %}
          {% else %}
            <picture>
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </picture>
          {% endif %}
        </figure>
        <div {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500"{% endif %} class="{{ text_position }}">
          {%- for block in section.blocks -%}
          {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'spacer' -%}
            <style>
              @media only screen and (min-width: 47.5em) {
                #shopify-section-{{ section.id }} #block-{{ block.id }} { margin-bottom:{{ block.settings.height }}px; }
              }
              @media only screen and (max-width: 47.5em) {
                #shopify-section-{{ section.id }} #block-{{ block.id }} { margin-bottom:{{ block.settings.height_mobile }}px; }
              }
            </style>
            <div class="module-spacer" id="block-{{ block.id }}" {{ block.shopify_attributes }}></div>
          {% when 'title' -%}
          {%- liquid
            assign no_margin = false
            assign next_block = forloop.index
            if section.blocks[next_block].type == 'title'
              assign no_margin = true
            endif
          -%}
          {%- if block.settings.title != empty -%}<{{ block.settings.title_size }} class="{% if block.settings.enable_custom_text_styling %} text-palette-{{ block.settings.title_color_palette }} fw-{{ block.settings.title_weight }} {% endif %}ff-{{ block.settings.title_font }} {% if no_margin %}margin-0{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.title }}</{{ block.settings.title_size }}>{%- endif -%}
        {% when 'text' -%}
          {% if block.settings.text != empty %}
            <div class="ff-{{ block.settings.font }} {% if block.settings.enable_custom_text_styling %}fw-{{ block.settings.font_weight }}{% endif %}"{% if block.settings.enable_custom_text_styling %} style="--main_fz:{{ block.settings.font_size }};font-size:var(--main_fz);"{% endif %} {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% endif %}
        {% when 'usp' -%}
          <ul class="l4us ff-{{ block.settings.font }} fw-{{ settings.body_font_weight }}" {% if block.settings.enable_custom_text_styling %}style="font-size:{{ block.settings.font_size }};"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.usp != empty -%}<li><span>{{ block.settings.usp }}</span></li>{%- endif -%}
          </ul>
        {% when 'buttons' -%}
          {%- liquid
            if block.settings.link_text_1 != empty and block.settings.link_url_1 != blank
              assign show_buttons = true
            endif
            if block.settings.link_text_2 != empty and block.settings.link_url_2 != blank
              assign show_buttons = true
            endif
          -%}
          {%- if show_buttons -%}
            <p class="link-btn" {{ block.shopify_attributes }} style="--dist_ba: 20px">
              {%- if block.settings.link_text_1 != empty and block.settings.link_url_1 != blank -%}
                <a href="{{ block.settings.link_url_1 }}" class="{% if block.settings.show_link_1 %}inline{% elsif block.settings.button_style_1 == 'inv' %} inv{% endif %} button-palette-{{ block.settings.button_color_palette_1 }}">{{ block.settings.link_text_1 }}&nbsp;{% if block.settings.show_link_1 %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}</a>
              {%- endif %}
              {%- if block.settings.link_text_2 != empty and block.settings.link_url_2 != blank -%}
                <a href="{{ block.settings.link_url_2 }}" class="{% if block.settings.show_link_2 %}inline{% elsif block.settings.button_style_2 == 'inv' %} inv{% endif %} button-palette-{{ block.settings.button_color_palette_2 }}">{{ block.settings.link_text_2 }}&nbsp;{% if block.settings.show_link_2 %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}</a>
              {%- endif %}
            </p>
          {%- endif -%}
        {%- endcase -%}
        {%- endfor -%}
        </div>
      </article>
    </div>
  </div>
</article>

<style>
  {% if section.settings.custom_background %}
  #shopify-section-{{ section.id }} .img-overlay.overlay-theme { --primary_bg: {{ custom_background }}; }
  {% endif %}
  #shopify-section-{{ section.id }} .module-color-palette article:before { opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; }
  #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
  @media only screen and (min-width: 47.5em) {
    #shopify-section-{{ section.id }} .m6bx { margin-bottom: {{ section.settings.spacing_desktop }}px; }

  }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} .m6bx { margin-bottom: {{ section.settings.spacing_mobile }}px; }
  }
</style>

