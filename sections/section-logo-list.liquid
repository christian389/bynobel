{%- liquid
  assign number = section.settings.number_of_items
  case number
    when 0
      assign width_class = 'width-33'
    when 1
      assign width_class = 'width-33'
    when 2
      assign width_class = 'width-50'
    when 3
      assign width_class = 'width-33'
    when 4
      assign width_class = 'width-25'
    when 5
      assign width_class = 'width-20'
    when 6
      assign width_class = 'width-16'
    when 7
      assign width_class = 'width-14'
    else
      assign width_class = 'width-12'
  endcase


  if section.settings.link_text != empty and section.settings.link_url != blank
    assign link = true
  endif

  if section.settings.title != empty
    assign show_header = true
  elsif link and section.settings.text_alignment == 'start'
    assign show_header = true
  endif

  capture title_classes
    if section.settings.text_alignment == 'center'
      echo ' text-center align-center'
    endif
  endcapture
-%}

{%- if link %}
  {%- capture link -%}
      <p class="class-x link-btn button-palette-{{ section.settings.button_color_palette }}"><a href="{{ section.settings.link_url }}" class="{% if section.settings.show_link %}inline{% elsif settings.button_style == 'inv' %}inv{% endif %}">{{ section.settings.link_text }}{% if section.settings.show_link %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}</a></p>
  {%- endcapture %}
{%- endif -%}

<article>
  {%- if show_header -%}
    <header {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500"{% endif %} class="{{ title_classes }} align-down cols">
      <div>
        {%- if section.settings.title != blank -%}
          <{{ section.settings.title_size }} class="ff-{{ section.settings.title_font }} {% if section.settings.enable_custom_text_styling %}text-palette-{{ section.settings.title_color_palette }} fw-{{ section.settings.title_weight }}{% endif %} margin-30 margin-mobile-20">{{ section.settings.title }}</{{ section.settings.title_size }}>
        {%- endif -%}
      </div>
      {%- if link and section.settings.text_alignment == 'start' -%}
        {{ link | replace: 'class-x', 'mobile-hide' }}
      {%- endif -%}
    </header>
  {%- endif -%}
  <ul class="l4cl
    hover-out
    {{ width_class }}
    {% if section.blocks.size > section.settings.number_of_items %} slider{% else %}text-{{ section.settings.text_alignment }}{% endif %}
  " style="{% if settings.enable_animations %}--nav_delay: 300;{% endif %}">
    {%- for block in section.blocks -%}
      {%- liquid
        capture current
          cycle 1, 2, 3, 4, 5, 6
        endcapture
      -%}
      <li {{ block.shopify_attributes }} {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500" data-sal-delay="{{ forloop.index0 | times: 50 }}"{% endif %}>
        <figure class="orientation-stripe no-hover margin-0{% if block.settings.image_dark %} dark-hide{% endif %}">
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.image.alt | default: section.settings.title | escape | default: "Logo" }}">{%- endif -%}
            <picture>
              {%- if block.settings.image -%}
                <img
                    src="{{ block.settings.image | image_url: width: 150 }}"
                    srcset="{% render 'image-srcset', image: block.settings.image, max_width: 350 %}"
                    sizes="
                      {% comment %}(min-width: 1300px) {%- if img_width == 100 -%} calc(1280px * 0.2), {%- else -%} calc(1280px * 0.{{ img_width }}), {%- endif -%}
                      (min-width: 760px) {%- if img_width == 100 -%} calc(100vw * 0.2) {%- else -%} calc(100vw * 0.{{ img_width }}), {%- endif -%}{% endcomment %}
                      150px
                    "
                  width="120"
                  height="75"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  {% comment %}style="max-width: 120px!important"{% endcomment %}
                  class="align-center"
                >
              {%- else -%}
                {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif %}
            </picture>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </figure>
        {%- if block.settings.image_dark and block.settings.image -%}
          <figure class="orientation-stripe no-hover dark-only margin-0">
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.image.alt | default: section.settings.title | escape | default: "Logo" }}">{%- endif -%}
              <picture>
                  <img
                      src="{{ block.settings.image_dark | image_url: width: 150 }}"
                      srcset="{% render 'image-srcset', image: block.settings.image_dark, max_width: 350 %}"
                      sizes="
                        {% comment %}(min-width: 1300px) {%- if img_width == 100 -%} calc(1280px * 0.2), {%- else -%} calc(1280px * 0.{{ img_width }}), {%- endif -%}
                        (min-width: 760px) {%- if img_width == 100 -%} calc(100vw * 0.2) {%- else -%} calc(100vw * 0.{{ img_width }}), {%- endif -%}{% endcomment %}
                        150px
                      "
                    width="120"
                    height="75"
                    alt="{{ block.settings.image_dark.alt | default: block.settings.title | escape }}"
                    loading="lazy"
                    {% comment %}style="max-width: 120px!important"{% endcomment %}
                    class="align-center"
                  >
              </picture>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </figure>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
  {%- if link and section.settings.text_alignment == 'center' -%}
    {{ link | replace: 'class-x', 'text-center' }}
  {%- elsif link -%}
      {{ link | replace: 'class-x', 'mobile-only' }}
  {%- endif -%}
</article>

<style>
  #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
  @media only screen and (min-width: 47.5em) {
      #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_desktop }}px; }
  }
  @media only screen and (max-width: 47.5em) {
      #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_mobile }}px; }
  }
</style>

