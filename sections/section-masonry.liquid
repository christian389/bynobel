      "options": [
        {
          "value": "boxed",
          "label": "t:sections.masonry.settings.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.masonry.settings.width.options__2.label"
        }
      ],
      "default": "boxed"
    },
    {
      "type": "range",
      "id": "space_between",
      "label": "t:sections.masonry.settings.space_between.label",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "id": "image_zoom",
      "type": "checkbox",
      "label": "t:sections.masonry.settings.image_zoom.label",
      "default": true
    },
    {
