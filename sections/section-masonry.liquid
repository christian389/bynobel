{%- liquid
    case section.blocks.size
      when 1
        assign height = 'size-l'
        assign height_mirrored = 'size-l'
      when 2
        assign height = 'size-l, size-l'
        assign height_mirrored = 'size-l, size-l'
      when 3
        assign height = 'size-s, size-l, size-s'
        assign height_mirrored = 'size-l, size-s, size-s'
      when 4
        assign height = 'size-l, size-s, size-l, size-s'
        assign height_mirrored = 'size-s, size-l, size-l, size-s'
    endcase
    assign height = height | split: ','
    assign height_mirrored = height_mirrored | split: ','

    assign last_blocks = section.blocks.size | modulo : 2
-%}

<article>
  <ul class="l4ft
    {% if section.settings.width == 'wide' %}fullwidth{% endif %}
    {% unless section.settings.image_zoom %}no-hover{% endunless %}
    {% if section.settings.layout_mobile == 'rows' %}mobile-scroll{% endif %}
    masonry
    "
    style="--spacing: {{ section.settings.space_between }}px;">
    {% assign counter = 1 %}
    {%- for block in section.blocks -%}
      {%- liquid
        capture current
          cycle 1, 2
        endcapture
        if section.settings.mirrored
          assign height_class = height_mirrored[forloop.index0] | strip
        else
          assign height_class = height[forloop.index0] | strip
        endif
        assign img_width = 50 | plus: 0

        if height_class == 'size-l' and forloop.length == 3
          assign height_class = 'size-s-double'
        endif

        assign blocks_left = forloop.length | minus: forloop.index
        assign items_per_row = 2
        if blocks_left < last_blocks
          assign items_per_row = last_blocks
        endif

        assign border_class = ''
        if counter == 1
          assign border_class = 'first-in-row'
        elsif counter == items_per_row
          assign border_class = 'last-in-row'
        endif

        assign lazyload = true
        if section.index == 1
          if forloop.index == 1
            assign lazyload = false
          elsif forloop.index == 2 and forloop.length == 3
            assign lazyload = false
          endif
        endif
      -%}
      <li class="block-{{ block.id }}
        {{ block.settings.text_position }}
        {% if section.blocks.size == 1 %}width-100{% else %}width-50{% endif %}
        {{ height_class }}
        {{ section.settings.mobile_height }}-mobile
        {{ border_class }}
        "
        {{ block.shopify_attributes }}
        {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500" data-sal-delay="{{ forloop.index0 | times: 100 }}"{% endif %}
        style="{% if block.settings.enable_custom_font_styling %}font-size:{{ block.settings.font_size }};{% endif %}
        "
      >
        {%- if counter == items_per_row -%}
          {% assign counter = 1 %}
        {%- else -%}
          {% assign counter = counter | plus: 1 %}
        {%- endif -%}
        <div class="palette-{{ block.settings.color_palette }}
            module-color-palette
            main">
          <figure>
            {%- if block.settings.video -%}
              {% if block.settings.enable_controls %}<a href="./" {% if block.settings.image_mobile %}class="mobile-hide"{% endif %} aria-label="{{ block.settings.title | escape | default: "Play video" }}">{% endif %}
                <picture {% if block.settings.image_mobile %}class="mobile-hide"{% endif %}>
                  <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                  {%- liquid
                    assign source = block.settings.video.sources | where: "height", 1080 | where: "format", "mp4" | first
                    if source == nil
                      assign source = block.settings.video.sources | where: "format", "mp4" | first
                    endif
                    if source == nil
                      assign source = block.settings.video.sources | where: "format", "mov" | first
                    endif
                    if source == nil
                      assign source = block.settings.video.sources.first
                    endif
                  -%}
                  <video class="lazy next-video" {% if block.settings.enable_controls %}{% if block.settings.video_mute %} muted{% endif %}{% else %}autoplay muted{% endif %} loop playsinline poster="{{ block.settings.video.preview_image | image_url }}">
                    <source data-src="{{ source.url }}" type="video/mp4">
                  </video>
                </picture>
                {% if block.settings.enable_controls %}
                  <i aria-hidden="true" class="icon-play {% if block.settings.image_mobile %}mobile-hide{% endif %}"></i>
                {% endif %}
              {% if block.settings.enable_controls %}</a>{% endif %}
              {% if block.settings.image_mobile %}
                <picture class="mobile-only">
                  <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                  <img
                    src="{{ block.settings.image_mobile | image_url: width: 620 }}"
                    srcset="{% render 'image-srcset', image: block.settings.image_mobile %}"
                    sizes="(min-width: 768px) 0, {% if section.settings.layout_mobile == 'compact' %}315px{% else %}100vw{% endif %}"
                    width="620"
                    height="700"
                    alt="{{ block.settings.image_mobile.alt | default: block.settings.title | escape }}"
                    style="object-position: {{ block.settings.image.presentation.focal_point }}"
                    class="mobile-only"
                    {% if lazyload %}loading="lazy"{% endif %}
                  >
                </picture>
              {% endif %}
            {%- elsif block.settings.image -%}
              {% if block.settings.image_mobile %}
                <picture class="mobile-only">
                  <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                  <img
                    src="{{ block.settings.image_mobile | image_url: width: 620 }}"
                    srcset="{% render 'image-srcset', image: block.settings.image_mobile %}"
                    sizes="(min-width: 768px) 0, {% if section.settings.layout_mobile == 'compact' %}315px{% else %}100vw{% endif %}"
                    width="620"
                    height="700"
                    alt="{{ block.settings.image_mobile.alt | default: block.settings.title | escape }}"
                    style="object-position: {{ block.settings.image.presentation.focal_point }}"
                    class="mobile-only"
                    {% if lazyload %}loading="lazy"{% endif %}
                  >
                </picture>
              {% endif %}
                <picture {% if block.settings.image_mobile %}class="mobile-hide"{% endif %}>
                  <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
                  <img
                    src="{{ block.settings.image | image_url: width: 620 }}"
                    srcset="{% render 'image-srcset', image: block.settings.image %}"
                    sizes="
                     {% if section.settings.width == 'boxed' or settings.width < 2000 %}
                      (min-width: 1300px) {% if img_width == 100 %}{{ settings.width }}px{% else %}calc({{ settings.width }}px * 0.{{ img_width }}){%- endif -%},
                     {% endif %}
                      (min-width: 760px) {% if img_width == 100 %}100vw{% else %}calc(100vw * 0.{{ img_width }}){%- endif -%},
                      {% if block.settings.image_mobile %}0{% else %}{% if section.settings.layout_mobile == 'compact' %}315px{% else %}100vw{% endif %}{% endif %}
                    "
                    width="620"
                    height="700"
                    alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                    style="object-position: {{ block.settings.image.presentation.focal_point }}"
                     {% if block.settings.image_mobile %}class="mobile-hide"{% endif %}
                    {% if lazyload %}loading="lazy"{% endif %}
                  >
              </picture>
            {% else %}
              <picture>
                <span class="img-overlay" style="opacity:{{ block.settings.overlay_opacity_img | divided_by: 100.0 }}"></span>
                {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              </picture>
            {% endif %}
          </figure>
          {%- unless block.settings.video -%}
            {%- if settings.banners_clickable and block.settings.link_url != blank -%}
              <a class="link-overlay" href="{{ block.settings.link_url }}" aria-label="{{ block.settings.title | escape | default: block.settings.image.alt | default: "Image banner" }}"></a>
            {%- endif -%}
          {%- endunless -%}
          <div>
            {%- if block.settings.title != blank -%}
              <{{ block.settings.title_size }} class="ff-{{ block.settings.title_font }} {% if block.settings.enable_custom_text_styling %}text-palette-{{ block.settings.title_color_palette }} fw-{{ block.settings.title_weight }}{% endif %}">{{ block.settings.title }}</{{ block.settings.title_size }}>
            {%- endif -%}
            {%- if block.settings.text -%}{{ block.settings.text }}{%- endif -%}
            {%- if block.settings.link_text != empty and block.settings.link_url != blank -%}
              <p class="link-btn button-palette-{{ block.settings.button_color_palette }}">
                <a href="{{ block.settings.link_url }}" class="{% if block.settings.show_link %}inline{% elsif settings.button_style == 'inv' %} inv{% endif %}">
                  {{ block.settings.link_text }}&nbsp;{% if block.settings.show_link %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}
                </a>
              </p>
            {%- endif %}
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</article>

<style>
  #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
  @media only screen and (min-width: 47.5em) {
    #shopify-section-{{ section.id }} .l4ft { margin-bottom: {{ section.settings.spacing_desktop | minus: section.settings.space_between }}px; }
  }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} .l4ft { margin-bottom: 0; }
    {% if section.settings.layout_mobile == 'rows' %}
      #shopify-section-{{ section.id }} .l4ft { margin-bottom: {{ section.settings.spacing_mobile }}px; }
    {% else %}
      #shopify-section-{{ section.id }} .l4ft { margin-bottom: {{ section.settings.spacing_mobile | minus: 16 }}px; }
    {% endif %}
  }
</style>

{% schema %}
