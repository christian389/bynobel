  "max_blocks": 4,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.masonry.settings.layout.header"
    },
    {
      "id": "mirrored",
      "type": "checkbox",
      "label": "Mirrored"
    },
    {
      "type": "select",
      "id": "width",
