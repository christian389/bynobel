<div class="
  m6fr
  mobile-text-center
  slider-fraction
  {{ section.settings.width }}
  {% if section.settings.width == 'wide' %}wide-transparent{% endif %}
  {% if section.settings.height != 'adapt' %}size-{{ section.settings.height }}{% endif %}
  {% if section.settings.height_mobile != 'adapt' %}size-{{ section.settings.height_mobile }}-mobile{% else %}size-xs-mobile{% endif %}
  {% unless section.settings.enable_controls %}no-controls{% endunless %}
  "
  {% if section.settings.autoplay %}data-autoplay={{ section.settings.autoplay_seconds | times: 1000 }}{% endif %}
  data-active-content="palette-{{ section.blocks[0].settings.color_palette }}"
  {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500"{% endif %}
  >
  {% liquid
    assign ref_img = section.blocks.first.settings.image
    if section.settings.enable_custom_height or ref_img == blank
      assign padding_bottom = 0
    else
      if section.settings.height == 'adapt'
        assign padding_bottom = 1 | divided_by: ref_img.aspect_ratio | times: 100 | round: 2
      endif
    endif

    if section.settings.height_mobile == 'adapt'
      if section.blocks.first.settings.image_mobile
        assign ref_img = section.blocks.first.settings.image_mobile
      endif
      assign padding_bottom_mobile = 1 | divided_by: ref_img.aspect_ratio | times: 100 | round: 2
    endif

    if section.blocks.first.settings.video
      assign padding_bottom = 1 | divided_by: section.blocks.first.settings.video.aspect_ratio | times: 100 | round: 2
      assign padding_bottom_mobile = 1 | divided_by: section.blocks.first.settings.video.aspect_ratio | times: 100 | round: 2
    endif
  %}

  {%- for block in section.blocks -%}
    {%- liquid
      capture current
        cycle 1, 2
      endcapture
      assign overlay = false
      assign background_color = settings.body_background_color | upcase
      assign color_palette_handle = 'palette_' | append: block.settings.color_palette
      assign color_palette = settings[color_palette_handle] | upcase
      if color_palette != background_color
        assign overlay = true
      endif

      assign custom_background = block.settings.background_color
      if block.settings.background_gradient != empty
        assign custom_background = block.settings.background_gradient
      endif
    -%}
    {% if block.settings.image_mobile %}
      {% capture mobile_image %}
        <picture class="mobile-only">
          <span class="img-overlay" style="--overlay_opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
          {% capture srcset %}
            {% render 'image-srcset', image: block.settings.image_mobile, max_width: 940 %}
          {% endcapture %}
          {% capture sizes %}
            (min-width: 768px) 0,
            100vw
          {% endcapture %}
          {% assign alt = block.settings.image_mobile.alt | default: block.settings.title | escape %}
          {%- if forloop.first and section.index == 1 -%}
            {{ block.settings.image_mobile | image_url: width: 700, height: 530, crop: 'center' | image_tag: srcset: srcset, sizes: sizes, preload: true, alt: alt }}
          {%- else %}
            {{ block.settings.image_mobile | image_url: width: 700, height: 530, crop: 'center' | image_tag: srcset: srcset, sizes: sizes, loading: 'lazy', alt: alt }}
          {%- endif -%}
        </picture>
      {% endcapture %}
    {% endif %}
    <article class="palette-{{ block.settings.color_palette }}
      block-{{ block.id }}
      {% unless block.settings.layout == 'background' %}
        width-{{ block.settings.image_width }} w-aside
        {% unless overlay %}
          has-border
        {% endunless %}
      {% endunless %}
      {% if block.settings.layout == 'right' %}inv{% endif %}
      module-color-palette
      "
      data-slide-index={{ forloop.index }}
      data-color-palette="{{ block.settings.color_palette }}"
      {{ block.shopify_attributes }}
       style="
       {% if section.settings.height == 'adapt' %}--aspect: {{ padding_bottom }};{% endif %}
       {% if section.settings.height_mobile == 'adapt' %}--aspect_m: {{ padding_bottom_mobile }};{% endif %}
       {% if block.settings.enable_custom_font_styling %}
        --main_fz:{{ block.settings.font_size }};
         font-size:var(--main_fz);
       {% endif %}
       {% unless block.settings.layout == 'background' %}--width: {{ block.settings.image_width }}%;{% endunless %}
       --align_text: {{ block.settings.text_position | split: ' ' | first }};
       --justify_text: {{ block.settings.text_position | split: ' ' | last }};
               "
    >
      <figure>
        {%- if block.settings.video -%}
          {% if block.settings.show_play_button %}<a href="./"{% if block.settings.image_mobile %} class="mobile-hide"{% endif %} aria-label="{{ block.settings.title | escape | default: "Play video" }}">{% endif %}
            <picture{% if block.settings.image_mobile %} class="mobile-hide"{% endif %}>
              <span class="img-overlay" style="--overlay_opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
              {%- liquid
                assign source = block.settings.video.sources | where: "height", 1080 | where: "format", "mp4" | first
                if source == nil
                  assign source = block.settings.video.sources | where: "format", "mp4" | first
                endif
                if source == nil
                  assign source = block.settings.video.sources | where: "format", "mov" | first
                endif
                if source == nil
                  assign source = block.settings.video.sources.first
                endif
              -%}
              <video class="lazy next-video" {% if block.settings.show_play_button %}{% if block.settings.video_mute %} muted{% endif %}{% else %}autoplay muted{% endif %} loop playsinline poster="{{ block.settings.video.preview_image | image_url }}">
                <source data-src="{{ source.url }}" type="video/mp4">
              </video>
              {% if block.settings.show_play_button %}<i aria-hidden="true" class="icon-play"></i>{% endif %}
            </picture>
          {% if block.settings.show_play_button %}</a>{% endif %}
          {{ mobile_image }}
        {%- elsif block.settings.image -%}
          <picture{% if block.settings.image_mobile %} class="mobile-hide"{% endif %}>
            <span class="img-overlay" style="--overlay_opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
            {% capture srcset %}
              {% render 'image-srcset', image: block.settings.image, max_width: 2900 %}
            {% endcapture %}
            {% capture sizes %}
              (min-width: 1300px)
              {% if section.settings.width == 'boxed' or settings.width < 2000 %}
                {% if block.settings.layout == 'background' %}{{ settings.width }}px{% else %}calc({{ settings.width }}px / 2),{% endif %}
              {% else %}
                {% if block.settings.layout == 'background' %}100vw{% else %}calc(100vw / 2),{% endif %}
              {% endif %}
              {% if block.settings.image_mobile %}0{% else %}100vw{% endif %}
            {% endcapture %}
            {% assign alt = block.settings.image.alt | default: block.settings.title | escape %}
            {%- if forloop.first -%}
              {{ block.settings.image | image_url: width: 700, height: 530, crop: 'center' | image_tag: srcset: srcset, sizes: sizes, preload: true, alt: alt }}
            {%- else %}
              {{ block.settings.image | image_url: width: 700, height: 530, crop: 'center' | image_tag: srcset: srcset, sizes: sizes, loading: 'lazy', alt: alt }}
            {%- endif -%}
          </picture>
          {{ mobile_image }}
        {% else %}
          <picture>
            <span class="img-overlay" style="--overlay_opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"></span>
            {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
          </picture>
        {% endif %}
        {%- if settings.banners_clickable and block.settings.first_link_url != blank -%}
          <a class="link-overlay" href="{{ block.settings.first_link_url }}" aria-label="{{ block.settings.title | escape | default: block.settings.image.alt | default: "Image banner" }}"></a>
        {%- endif -%}
      </figure>
      <div class="text-{{ block.settings.text_position | split: ' ' | last }}" style="{% if block.settings.layout == 'background' %}--width: {{ block.settings.max_width }}px{% endif %}">
      {%- if block.settings.subtitle != blank -%}<{{ block.settings.subtitle_size }} class="{% if block.settings.enable_custom_subtext_styling %} text-palette-{{ block.settings.subtitle_color_palette }} fw-{{ block.settings.subtitle_weight }} {% endif %}ff-{{ block.settings.subtitle_font }}{% if block.settings.title != blank%} {% if block.settings.subtitle_margin == 'small' %}margin-0{% elsif block.settings.subtitle_margin == 'large' %}margin-content{% endif %}{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.subtitle }}</{{ block.settings.subtitle_size }}>{%- endif -%}
      {%- if block.settings.title != blank -%}<{{ block.settings.title_size }} class="{% if block.settings.enable_custom_text_styling %} text-palette-{{ block.settings.title_color_palette }} fw-{{ block.settings.title_weight }} {% endif %}ff-{{ block.settings.title_font }}" {{ block.shopify_attributes }}>{{ block.settings.title }}</{{ block.settings.title_size }}>{%- endif -%}
        {%- if block.settings.text -%}{{ block.settings.text }}{%- endif -%}
        {%- if block.settings.link_text != empty or block.settings.second_link_text != empty -%}
          <p class="link-btn" style="--dist_ba: 20px">
            {%- if block.settings.first_link_text != empty and block.settings.first_link_url != blank -%}
              <a href="{{ block.settings.first_link_url }}" class="button-palette-{{ block.settings.first_button_color_palette }}{% if block.settings.first_show_link %} inline{% elsif block.settings.first_button_styling == 'inv' %} inv{% endif %}">{{ block.settings.first_link_text }}{% if block.settings.first_show_link %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}</a>
            {% endif %}
            {%- if block.settings.second_link_text != empty and block.settings.second_link_url != blank -%}
              <a href="{{ block.settings.second_link_url }}" class="button-palette-{{ block.settings.second_button_color_palette }}{% if block.settings.second_show_link %} inline{% elsif block.settings.second_button_styling == 'inv' %} inv{% endif %}">{{ block.settings.second_link_text }}{% if block.settings.second_show_link %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}</a>
            {%- endif -%}
          </p>
        {%- endif -%}
        {%- if settings.banners_clickable and block.settings.first_link_url != blank -%}
          <a class="link-overlay" href="{{ block.settings.first_link_url }}" aria-label="{{ block.settings.title | escape | default: block.settings.image.alt | default: "Image banner" }}"></a>
        {%- endif -%}
      </div>
      <style>
        #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
        {%- if section.settings.width == 'wide' -%}
        #shopify-section-{{ section.id }} .m6fr article.block-{{ block.id }}:before { opacity: {{ block.settings.background_overlay_opacity | divided_by: 100.0 }}; }
        {%- endif -%}
        {% if block.settings.custom_background %}
          #shopify-section-{{ section.id }} .m6fr article.block-{{ block.id }}:before,
          #shopify-section-{{ section.id }} .m6fr .block-{{ block.id }} .overlay-theme,
          #shopify-section-{{ section.id }} .m6fr .block-{{ block.id }} .img-overlay { --primary_bg: {{ custom_background }}; }
        {% endif %}
      </style>
    </article>
  {%- endfor -%}
</div>

<style>
  {%- if section.settings.width == 'wide' -%}
  html.no-js .shopify-section-header:has(#header-outer.transparent):has(+ #content > div:first-child[id$="{{ section.id }}"] > .wide-transparent.slider-fraction) {
    --top_main_bg: var(--{{ section.blocks.first.settings.color_palette }}_bg) !important;
    --top_main_fg: var(--{{ section.blocks.first.settings.color_palette | replace: '_gradient', '' }}_fg) !important;
    --menu_fg: var(--top_main_fg) !important;
  }
  {% endif %}

  #shopify-section-{{ section.id }} .m6fr.no-controls .play-pause { display: none; }
  @media only screen and (min-width: 47.5em) {
    #shopify-section-{{ section.id }} .m6fr { margin-bottom: {{ section.settings.spacing_desktop }}px; }
    {% if section.settings.enable_custom_height %}
      #shopify-section-{{ section.id }} article { --mh: {{ section.settings.custom_height }}px; }
    {% endif %}
  }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} .m6fr { margin-bottom: {{ section.settings.spacing_mobile }}px; }
  }

  #shopify-section-{{ section.id }} .m6fr article:not(.w-aside) {
      flex-direction: row;
      justify-content: var(--justify_text);
      align-items: var(--align_text);
  }
</style>

{%- if section.settings.width == 'wide' -%}
  <script>
    var html_tag = document.documentElement,
        root_styles = document.querySelector(':root'),
        content_id = document.getElementById('content'),
        header_outer = document.getElementById('header-outer'),
        ffa = content_id.children[0],
        ffc,
        ffd = false;
    if (ffa !== undefined) {
      ffc = ffa.children[0];
      if (ffa.classList.contains('shopify-section') && header_outer.hasAttribute('data-transparent') && ffa.id == 'shopify-section-' + '{{ section.id }}') {
        ffd = true;
      }
      if (ffc !== undefined && ffc.classList.contains('m6bx') && ffc.classList.contains('wide') || ffc !== undefined && ffc.classList.contains('m6fr') && ffc.classList.contains('wide')) {
        ffe = true;
      }
      if (document.querySelectorAll('.shopify-section-header ~ [class*="shopify-section-announcement-bar"]').length) {
        ffd = false;
      }
      if (ffd === true) {
        header_outer.classList.add('transparent');
        html_tag.classList.add('has-first-m6fr-wide');
        html_tag.classList.add('dm-ready');
        root_styles.style.setProperty('--transparent_header_fg', 'var(--{{ section.blocks.first.settings.color_palette | remove: '_gradient' }}_fg)');
        root_styles.style.setProperty('--transparent_header_fg_hover', 'var(--{{ section.blocks.first.settings.color_palette | remove: '_gradient' }}_btn_bg)');
        root_styles.style.setProperty('--transparent_header_bg', 'var(--{{ section.blocks.first.settings.color_palette }}"_bg)');
      }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.slideshow.settings.width.label",
      "info": "t:sections.slideshow.settings.width.info",
      "options": [
        {
          "value": "boxed",
          "label": "t:sections.slideshow.settings.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.slideshow.settings.width.options__2.label"
        }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.slideshow.settings.height.label",
      "info": "t:sections.slideshow.settings.height.info",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.slideshow.settings.height.options__1.label"
        },
        {
          "value": "s",
          "label": "t:sections.slideshow.settings.height.options__2.label"
        },
        {
          "value": "m",
          "label": "t:sections.slideshow.settings.height.options__3.label"
        },
        {
          "value": "l",
          "label": "t:sections.slideshow.settings.height.options__4.label"
        },
        {
          "value": "xl",
          "label": "t:sections.slideshow.settings.height.options__5.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.slideshow.settings.height.adapt.label"
        }
      ],
      "default": "l"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_height",
      "label": "t:sections.slideshow.settings.enable_custom_height.label"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "t:sections.slideshow.settings.custom_height.label",
      "info": "t:sections.slideshow.settings.custom_height.info",
      "min": 250,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "id": "autoplay",
      "type": "checkbox",
      "label": "t:sections.slideshow.settings.autoplay.label"
    },
    {
      "id": "autoplay_seconds",
      "type": "range",
      "label": "t:sections.slideshow.settings.autoplay_seconds.label",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "id": "enable_controls",
      "type": "checkbox",
      "label": "t:sections.slideshow.settings.enable_controls.label",
      "info": "t:sections.slideshow.settings.enable_controls.info"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.mobile.header"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:sections.slideshow.settings.mobile.height_mobile.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.slideshow.settings.mobile.height_mobile.options__1.label"
        },
        {
          "value": "s",
          "label": "t:sections.slideshow.settings.mobile.height_mobile.options__2.label"
        },
        {
          "value": "m",
          "label": "t:sections.slideshow.settings.mobile.height_mobile.options__3.label"
        },
        {
          "value": "l",
          "label": "t:sections.slideshow.settings.mobile.height_mobile.options__4.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.slideshow.settings.mobile.height_mobile.adapt.label"
        }
      ],
      "default": "s"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.spacing.header"
    },
    {
      "id": "spacing_desktop",
      "type": "range",
      "label": "t:sections.slideshow.settings.spacing.spacing_desktop.label",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "id": "spacing_mobile",
      "type": "range",
      "label": "t:sections.slideshow.settings.spacing.spacing_mobile.label",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 30
    },
    {
      "id": "fix_zindex",
      "type": "range",
      "label": "t:global.fix_zindex.label",
      "info": "t:global.fix_zindex.info",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "id": "image",
          "type": "image_picker",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label",
          "info": "t:sections.slideshow.blocks.slide.settings.image.info"
        },
        {
          "id": "video",
          "type": "video",
          "label": "t:sections.slideshow.blocks.slide.settings.video.label",
          "info": "t:sections.slideshow.blocks.slide.settings.video.info"
        },
        {
          "id": "show_play_button",
          "type": "checkbox",
          "label": "t:global.video.enable_controls.label",
          "info": "t:global.video.enable_controls.info",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_mute",
          "label": "t:global.video.video_mute.label",
          "info": "t:global.video.video_mute.info",
          "default": true
        },
        {
          "id": "layout",
          "type": "select",
          "label": "t:sections.slideshow.blocks.slide.settings.layout.label",
          "options": [
            {
              "value": "left",
              "label": "t:sections.slideshow.blocks.slide.settings.layout.options__1.label"
            },
            {
              "value": "right",
              "label": "t:sections.slideshow.blocks.slide.settings.layout.options__2.label"
            },
            {
              "value": "background",
              "label": "t:sections.slideshow.blocks.slide.settings.layout.options__3.label"
            }
          ],
          "default": "background"
        },
        {
          "type": "range",
          "id": "image_width",
          "label": "t:sections.slideshow.blocks.slide.settings.image_width.label",
          "info": "t:sections.slideshow.blocks.slide.settings.image_width.info",
          "min": 40,
          "max": 60,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:sections.slideshow.blocks.slide.settings.overlay_opacity.label",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 25
        },
        {
          "type": "select",
          "id": "color_palette",
          "label": "t:global.color_palette.label",
          "options": [
            {
              "value": "white",
              "label": "t:global.color_palette.white.label"
            },
            {
              "value": "black",
              "label": "t:global.color_palette.black.label"
            },
            {
              "value": "light",
              "label": "t:global.color_palette.light.label"
            },
            {
              "value": "dark",
              "label": "t:global.color_palette.dark.label"
            },
            {
              "value": "accent",
              "label": "t:global.color_palette.accent.label"
            },
            {
              "value": "light_2",
              "label": "t:global.color_palette.light_2.label"
            },
            {
              "value": "light_gradient",
              "label": "t:global.color_palette.light_gradient.label"
            },
            {
              "value": "dark_gradient",
              "label": "t:global.color_palette.dark_gradient.label"
            }
          ],
          "default": "black"
        },
        {
          "type": "checkbox",
          "id": "custom_background",
          "label": "t:sections.slideshow.blocks.slide.settings.custom_background.label"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "t:global.background.background_color.label",
          "info": "t:global.background.background_color.info",
          "default": "#000000"
        },
        {
          "type": "color_background",
          "id": "background_gradient",
          "label": "t:global.background.background_gradient.label",
          "info": "t:global.background.background_gradient.info"
        },
        {
          "type": "range",
          "id": "background_overlay_opacity",
          "label": "t:global.background.background_overlay_opacity.label",
          "info": "t:sections.slideshow.blocks.slide.settings.image_width.info",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "id": "text_position",
          "type": "select",
          "label": "t:global.typography.text_position.label",
          "options": [
            {
              "value": "start",
              "label": "t:global.typography.text_position.top_left.label"
            },
            {
              "value": "start center",
              "label": "t:global.typography.text_position.top_center.label"
            },
            {
              "value": "start end",
              "label": "t:global.typography.text_position.top_right.label"
            },
            {
              "value": "center start",
              "label": "t:global.typography.text_position.center_left.label"
            },
            {
              "value": "center",
              "label": "t:global.typography.text_position.center_center.label"
            },
            {
              "value": "center end",
              "label": "t:global.typography.text_position.center_right.label"
            },
            {
              "value": "end start",
              "label": "t:global.typography.text_position.bottom_left.label"
            },
            {
              "value": "end center",
              "label": "t:global.typography.text_position.bottom_center.label"
            },
