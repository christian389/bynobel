{%- liquid
  case section.settings.items_width
    when 1
      assign width_class = 'width-100'
    when 2
      assign width_class = 'width-50'
    when 3
      assign width_class = ''
  endcase
  assign last_blocks = section.blocks.size | modulo : section.settings.items_width

  if section.settings.link_text != empty and section.settings.link_url != blank
    assign link = true
  endif

  if section.settings.title != empty or section.settings.text != empty or section.settings.link_text != empty
    assign show_header = true
  endif

  capture title_classes
    if section.settings.text_alignment == 'center'
        echo ' text-center align-center'
    endif
endcapture

-%}

{%- if link %}
  {%- capture link -%}
      <p class="class-x link-btn button-palette-{{ section.settings.button_color_palette }}"><a href="{{ section.settings.link_url }}" class="{% if section.settings.show_link %}inline{% elsif settings.button_style == 'inv' %}inv{% endif %}">{{ section.settings.link_text }}{% if section.settings.show_link %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}</a></p>
  {%- endcapture %}
{%- endif -%}

<article class="m6bx wide">
  <div class="palette-{{ section.settings.color_palette }} module-color-palette img-overlay overlay-theme{% if section.settings.custom_background %} dark-overlay-theme{% endif %}"
    style="--mih_desktop: 100%; --dist_half: 0%; --mih_mobile: 100%; --dist_half_mobile: 0%; opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  <div class="palette-{{ section.settings.color_palette }} module-color-palette">
    {%- if show_header -%}
      <header {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500"{% endif %} class="{{ title_classes }} align-down cols" {% if section.settings.enable_custom_font_styling %}style="font-size:{{ section.settings.font_size }};"{% endif %}>
        <div>
          {%- if section.settings.title != blank -%}
            <{{ section.settings.title_size }} class="ff-{{ section.settings.title_font }} {% if section.settings.enable_custom_text_styling %}text-palette-{{ section.settings.title_color_palette }} fw-{{ section.settings.title_weight }}{% endif %}{% if section.settings.text == blank %}margin-content margin-mobile-20{% endif %}">{{ section.settings.title }}</{{ section.settings.title_size }}>
          {%- endif -%}
          {%- if section.settings.text != empty -%}
            <p class="{% if section.settings.enable_custom_font_styling %} text-palette-{{ section.settings.text_color_palette }}{% endif %}">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
        {%- if link and section.settings.text_alignment == 'start' -%}
          {{ link | replace: 'class-x', 'mobile-hide' }}
        {%- endif -%}
      </header>
    {%- endif -%}
    <ul class="{% unless section.settings.testimonials_boxed %}palette-{{ section.settings.color_palette }} module-color-palette{% endunless %} {% if section.settings.layout == 'slider' %}palette-{{ section.settings.testimonials_color_palette }}{% endif %}
      l4ts
      {% if section.settings.testimonials_boxed %}box{% endif %}
      {% if section.settings.layout == 'slider' %}{{ width_class }} slider-aside{% else %}slider-fraction slider-mobile{% endif %}
      "
      {% if section.settings.layout == 'slider' and section.settings.autoplay %}data-autoplay={{ section.settings.autoplay_seconds | times: 1000 }}{% endif %}
      {% if section.settings.layout == 'slider' %}data-color-palette="palette-{{ section.settings.testimonials_color_palette }}" data-main-color-palette="palette-{{ section.settings.color_palette }}"{% endif %}
      {% if settings.enable_animations and section.settings.layout == 'slider' %}data-sal="fade" data-sal-duration="500" data-sal-delay="{{ forloop.index0 | times: 50 }}"{% endif %}
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign blocks_left = forloop.length | minus: forloop.index
          if blocks_left < last_blocks
            assign width = 100 | divided_by: last_blocks
            assign different_width_class = 'width-' | append: width
          else
            assign different_width_class = false
          endif
        -%}
        <li class="{% if section.settings.testimonials_boxed %}palette-{{ section.settings.testimonials_color_palette }} module-color-palette{% endif %} {% if different_width_class %}{{ different_width_class }}{% else %}{{ width_class }}{% endif %}"{% if section.settings.layout == 'slider' %} data-slide-index={{ forloop.index }}{% endif %} {{ block.shopify_attributes }} {% if settings.enable_animations and section.settings.layout == 'rows' %}data-sal="fade" data-sal-duration="500" data-sal-delay="{{ forloop.index0 | times: 50 }}"{% endif %}>
          {%- if block.settings.author != empty or block.settings.place != empty or block.settings.image -%}
            <p class="s1us">
              {%- if block.settings.image -%}
                {%- liquid
                  assign image_width = 65
                  assign image_width_2 = image_width | times: 2
                -%}
                <img
                  src="{{ block.settings.image | image_url: width: image_width }}"
                  srcset="{{ block.settings.image | image_url: width: image_width }} 1x,{{ block.settings.image | image_url: width: image_width_2 }} 2x"
                  width="65"
                  height="65"
                  alt="{{ block.settings.image.alt | default: block.settings.author | default: "Testimonial image" | escape }}"
                  loading="lazy"
                >
              {%- elsif block.settings.initials and block.settings.author != empty -%}
                <span class="palette-{{ block.settings.initials_color_palette }} module-color-palette img">
                  {%- liquid
                    assign names = block.settings.author | split: " "
                    if names.size > 1
                      for name in names limit: 2
                        echo name | slice: 0, 1 | upcase
                      endfor
                    else
                      echo block.settings.author | slice: 0, 2 | upcase
                  endif
                  -%}
                </span>
              {%- endif -%}
              {%- if block.settings.author != empty or block.settings.place != empty -%}
              <span>{% if block.settings.author != empty %}<span class="strong">{{ block.settings.author }}</span>{% endif %} {% if block.settings.place != empty %}{{ block.settings.place }}{% endif %}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- if block.settings.text != empty -%}
          <blockquote class="inline">
            <p>{{ block.settings.text }}</p>
          </blockquote>
          {%- endif -%}
          <p class="r6rt" data-val="{{ block.settings.score }}" data-of="5"></p>
        </li>
      {%- endfor -%}
    </ul>
    {%- if link and section.settings.text_alignment == 'center' -%}
      {{ link | replace: 'class-x', 'text-center' }}
    {%- elsif link -%}
        {{ link | replace: 'class-x', 'mobile-only' }}
    {%- endif -%}
  </div>
</article>

<style>
  {% comment %} #shopify-section-{{ section.id }} { margin-bottom: {{ section.settings.spacing_desktop }}px; } {% endcomment %}
  #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
  @media only screen and (min-width: 47.5em) {
    #shopify-section-{{ section.id }} .m6bx { margin-bottom: {{ section.settings.spacing_desktop }}px; }
  }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} .m6bx { margin-bottom: {{ section.settings.spacing_mobile }}px; }
  }
</style>

