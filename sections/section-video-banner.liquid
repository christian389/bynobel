{% liquid
  assign poster = ''
  if section.settings.image != blank
    assign poster = section.settings.image | image_url
  else
    assign poster = section.settings.video.preview_image | image_url
  endif

  assign controls_video_url = false
  if section.settings.enable_controls
    if section.settings.video_url != empty and section.settings.image != blank
      assign controls_video_url = true
    elsif section.settings.video and section.settings.video_url == blank
      assign controls_video_url = true
    endif
  endif

  assign custom_background = section.settings.background_color
  if section.settings.background_gradient != empty
    assign custom_background = section.settings.background_gradient
  endif

  capture background_classes
    if section.settings.background_overlay_opacity == 0
      echo 'no-padding'
    else
      if section.settings.background_height == 0 or section.settings.background_width == 0
        echo 'no-padding-desktop'
      endif
      if section.settings.background_height_mobile == 0 or section.settings.background_width_mobile == 0
        echo ' no-padding-mobile'
      endif
    endif
  endcapture
  
-%}
<article class="m6bx wide{% if section.settings.text_position == 'center' %} text-center{% endif %} next-video {{ background_classes }}">
  <div class="palette-{{ section.settings.background_color_palette }} module-color-palette img-overlay overlay-theme{% if section.settings.background_position == 'right' %} text-end{% endif %}{% if section.settings.custom_background %} dark-overlay-theme{% endif %}"
    style="--mih_desktop: {{ section.settings.background_height }}%; --dist_half: {{ 100 | minus: section.settings.background_width }}%; --mih_mobile: {{ section.settings.background_height_mobile }}%; --dist_half_mobile: {{ 100 | minus: section.settings.background_width_mobile }}%; opacity:{{ section.settings.background_overlay_opacity | divided_by: 100.0 }}"></div>
  <figure {% if settings.enable_animations %}data-sal="fade" data-sal-duration="500"{% endif %} class="margin-30 margin-mobile-20{% if section.settings.width == 'wide' %} media-wide{% endif %} orientation-landscape" style="--ratio: 0.5">
    {% if controls_video_url %}<a href="./" {% if section.settings.video_url %}data-{{ section.settings.video_url.type }}="{{ section.settings.video_url.id }}"{% endif %} aria-label="Play video">{% endif %}
        {% if section.settings.image and section.settings.enable_controls %}
          <span class="img-overlay" style="--overlay_opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"></span>
        {% endif %}
        <picture class="img-cover">
        {% if section.settings.video_url != blank %}
            {% if section.settings.image != blank and controls_video_url %}
              <img
                src="{{ section.settings.image | image_url: width: 100, height: 100, width: 640 }}"
                srcset="{% render 'image-srcset', image: section.settings.image %}"
                sizes="
                {% if settings.width < 2000 %}
                  (min-width: 1300px) calc({{ settings.width }}px / 2),
                {% endif %}
                (min-width: 760px) calc(100vw / 2),
                100vw
                "
                width="640"
                height="530"
                alt="{{ section.settings.image.alt | default: section.settings.title | escape }}"
                loading="lazy"
              >
            {% else %}
              <iframe src="{{ section.settings.video_url | replace: 'watch?v=', 'embed/' | replace: '//vimeo.com/', '//player.vimeo.com/video/' }}" title="{{ section.settings.video_alt_text | escape }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            {% endif %}
        {% elsif section.settings.video %}
          {%- liquid
            assign source = section.settings.video.sources | where: "height", 1080 | where: "format", "mp4" | first
            if source == nil
              assign source = section.settings.video.sources | where: "format", "mp4" | first
            endif
            if source == nil
              assign source = section.settings.video.sources | where: "format", "mov" | first
            endif
            if source == nil
              assign source = section.settings.video.sources.first
            endif
          -%}
          <video {% if controls_video_url %}{% if section.settings.video_mute %} muted{% endif %}{% else %}autoplay muted{% endif %} loop playsinline poster="{{ poster }}">
            <source src="{{ source.url }}" type="video/mp4">
          </video>
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </picture>
      {% if controls_video_url %}
        <i aria-hidden="true" class="icon-play"></i>
      {% endif %}
    {% if controls_video_url %}</a>{% endif %}
  </figure>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
        {%- when 'spacer' -%}
          <style>
            @media only screen and (min-width: 47.5em) {
              #shopify-section-{{ section.id }} #block-{{ block.id }} { margin-bottom:{{ block.settings.height }}px; }
            }
            @media only screen and (max-width: 47.5em) {
              #shopify-section-{{ section.id }} #block-{{ block.id }} { margin-bottom:{{ block.settings.height_mobile }}px; }
            }
          </style>
          <div class="module-spacer" id="block-{{ block.id }}" {{ block.shopify_attributes }}></div>
        {% when 'title' -%}
          {% if block.settings.title != empty %}
            {%- liquid
              assign no_margin = false
              assign next_block = forloop.index
              if section.blocks[next_block].type == 'title'
                assign no_margin = true
              endif
            -%}
          {%- if block.settings.title != empty -%}<{{ block.settings.title_size }} class="{% if block.settings.enable_custom_text_styling %} text-palette-{{ block.settings.title_color_palette }} fw-{{ block.settings.title_weight }} {% endif %}ff-{{ block.settings.title_font }} {% if no_margin %}margin-0{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.title }}</{{ block.settings.title_size }}>{%- endif -%}
          {% endif %}
        {% when 'text' -%}
          {% if block.settings.text != empty %}
            <div class="ff-{{ block.settings.font }} margin-0" style="font-size:{{ block.settings.font_size }};"{{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {% endif %}
        {% when 'buttons' -%}
          {%- liquid
            if block.settings.link_text_1 != empty and block.settings.link_url_1 != blank
              assign show_buttons = true
            endif
            if block.settings.link_text_2 != empty and block.settings.link_url_2 != blank
              assign show_buttons = true
            endif
          -%}
          {%- if show_buttons -%}
            <p class="link-btn" {{ block.shopify_attributes }} style="--dist_ba: 20px">
              {%- if block.settings.link_text_1 != empty and block.settings.link_url_1 != blank -%}
                <a href="{{ block.settings.link_url_1 }}" class="{% if block.settings.show_link_1 %}inline{% elsif block.settings.button_style_1 == 'inv' %} inv{% endif %} button-palette-{{ block.settings.button_color_palette_1 }}">{{ block.settings.link_text_1 }}{% if block.settings.show_link_1 %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}</a>
              {%- endif %}
              {%- if block.settings.link_text_2 != empty and block.settings.link_url_2 != blank -%}
                <a href="{{ block.settings.link_url_2 }}" class="{% if block.settings.show_link_2 %}inline{% elsif block.settings.button_style_2 == 'inv' %} inv{% endif %} button-palette-{{ block.settings.button_color_palette_2 }}">{{ block.settings.link_text_2 }}{% if block.settings.show_link_2 %}&nbsp;<i aria-hidden="true" class="icon-arrow-right"></i>{% endif %}</a>
              {%- endif %}
            </p>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
</article>

<style>
  #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
  {% if section.settings.custom_background %}
  #shopify-section-{{ section.id }} .img-overlay.overlay-theme { --primary_bg: {{ custom_background }}; }
  {% endif %}
  #shopify-section-{{ section.id }} .m6bx { margin-bottom: {{ section.settings.spacing_desktop }}px; }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} .m6bx { margin-bottom: {{ section.settings.spacing_mobile }}px; }
  }
</style>

