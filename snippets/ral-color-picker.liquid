.ral-modal{
  display:none;
  position:fixed;
  inset:0;
  z-index:9999999;
}
.ral-modal-overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,0.6);
  z-index:1;
}
.ral-modal-close{
border:none;
background: #9E915C;
font-size:28px;
cursor:pointer;
line-height:1;
padding:4px;

}

.ral-modal-close:hover{
