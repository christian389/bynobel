    "section_image_with_text_pamcQU": {
      "type": "section-image-with-text",
      "blocks": {
        "title_4wa6hm": {
          "type": "title",
          "settings": {
            "title": "DET GODE TERRASSELIV",
            "title_font": "primary",
            "title_size": "h3",
            "enable_custom_text_styling": false,
            "title_color_palette": "black",
            "title_weight": "700"
          }
        },
        "text_gty7Gf": {
          "type": "text",
          "settings": {
            "text": "<p>Terrassen eller orangeriet binder inde- og uderum sammen så boligen opleves større og grænserne mellem uderum og boligen udviskes. I dag er terrassemiljøer og orangerier populære som aldrig før og ofte lige så højt prioriteret som de øvrige rum i boligen. Indretningen skal være praktisk og hyggelig, uderummet skal fungere som en forlængelse af boligen med lækre designerhavemøbler, krukker, udekøkken, terrassevarmer, smart belysning osv. Under kategorien terrasseliv, finder du alle de produkter, der udover havemøblerne, giver mulighed for at skabe et skønt opholdsrum med middelhavsstemning og følelsen af at være på ferie. Vi har bl.a. et bredt udvalg af eksklusive franske plantekasser, espaliers til at skabe grønne vægge samt terrassevarmere der gør det muligt at forlænge sæsonen på terrassen eller i orangeriet.</p>",
            "font": "secondary",
            "enable_custom_text_styling": false,
            "font_weight": "400",
            "font_size": "16px"
          }
